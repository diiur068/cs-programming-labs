#figure(
  kind: image,
  align(left)[
```cpp
#include <iostream>

using namespace std;
int main(){
    double length, width;
    cin >> length;
    cin >> width;
    cout << "Площадь: " << (length * width) << endl;
    cout << "Периметр: " << (length + width) * 2;
    return 0;
}
```
